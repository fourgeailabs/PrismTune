<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground: the PrismTune Vinyl Ring (Concept 3,
  v3 full redesign, picked by Eric). A gold vinyl disc with concentric
  grooves, a charcoal centre hole, and a gold centre dot, centred in the
  108dp adaptive-icon frame. The disc (radius 32dp) sits inside the 66dp
  safe zone, so nothing important is cropped by launcher masks.
  The background (ic_launcher_background.xml) is uniform deep charcoal.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Vinyl disc -->
    <path
        android:fillColor="#FFB020"
        android:pathData="M22,54 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0 Z" />
    <!-- Gloss highlight, upper-left facet of the disc -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.22"
        android:pathData="M30,34 L54,28 L66,38 L44,46 Z" />
    <!-- Grooves -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BE5F05"
        android:strokeWidth="1"
        android:pathData="M27,54 a27,27 0 1,0 54,0 a27,27 0 1,0 -54,0 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BE5F05"
        android:strokeWidth="1"
        android:pathData="M31,54 a23,23 0 1,0 46,0 a23,23 0 1,0 -46,0 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BE5F05"
        android:strokeWidth="1"
        android:pathData="M35,54 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BE5F05"
        android:strokeWidth="1"
        android:pathData="M39,54 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0 Z" />
    <!-- Charcoal centre hole -->
    <path
        android:fillColor="#16120E"
        android:pathData="M45,54 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z" />
    <!-- Gold centre dot -->
    <path
        android:fillColor="#FFC93D"
        android:pathData="M50.5,54 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />
</vector>
