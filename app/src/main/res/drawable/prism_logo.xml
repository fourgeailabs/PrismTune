<?xml version="1.0" encoding="utf-8"?>
<!--
  PrismTune logo as a VectorDrawable: the Vinyl Ring (Concept 3, v3 full
  redesign, picked by Eric). A gold vinyl disc with concentric grooves,
  a charcoal centre hole, and a gold centre dot. This is an original mark:
  it is NOT Plex's ">" logo, and it uses no Plex artwork. The old
  triangle/prism mark is gone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Vinyl disc -->
    <path
        android:fillColor="#FFB020"
        android:pathData="M18,54 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0 Z" />
    <!-- Gloss highlight, upper-left facet of the disc -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.22"
        android:pathData="M28,32 L54,25 L68,37 L44,47 Z" />
    <!-- Grooves -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BE5F05"
        android:strokeWidth="1"
        android:pathData="M23,54 a31,31 0 1,0 62,0 a31,31 0 1,0 -62,0 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BE5F05"
        android:strokeWidth="1"
        android:pathData="M28,54 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BE5F05"
        android:strokeWidth="1"
        android:pathData="M33,54 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#BE5F05"
        android:strokeWidth="1"
        android:pathData="M38,54 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />
    <!-- Charcoal centre hole -->
    <path
        android:fillColor="#16120E"
        android:pathData="M43,54 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 Z" />
    <!-- Gold centre dot -->
    <path
        android:fillColor="#FFC93D"
        android:pathData="M50,54 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z" />
</vector>
